RoundMenu {
    background-color: transparent;
    border: none;
}

/* Paint the whole opaque client area. Windows 11's native menu painter reserves
   translucent decoration which becomes a white strip when DWM shadows require
   a non-layered window. These selectors stay local to DWM menus and submenus. */
QMenu[qssClass="DWMMenu"], QMenu[qssClass="DWMMenu"] QMenu {
    background-color: rgb(43, 43, 43);
    color: white;
    border: 1px solid rgb(65, 65, 65);
    padding: 4px;
    font: 14px --FontFamilies;
}
QMenu[qssClass="DWMMenu"]::item, QMenu[qssClass="DWMMenu"] QMenu::item {
    padding: 6px 38px;
    margin: 0px 2px;
    border-radius: 5px;
}
QMenu[qssClass="DWMMenu"]::item:selected, QMenu[qssClass="DWMMenu"] QMenu::item:selected {
    background-color: rgba(255, 255, 255, 0.08);
}
QMenu[qssClass="DWMMenu"]::item:disabled, QMenu[qssClass="DWMMenu"] QMenu::item:disabled {
    color: rgba(255, 255, 255, 0.4);
}
QMenu[qssClass="DWMMenu"]::separator, QMenu[qssClass="DWMMenu"] QMenu::separator {
    height: 1px;
    margin: 4px 6px;
    background-color: rgba(255, 255, 255, 0.1);
}
QMenu[qssClass="DWMMenu"]::indicator, QMenu[qssClass="DWMMenu"] QMenu::indicator {
    width: 14px;
    height: 14px;
}
QMenu[qssClass="DWMMenu"]::indicator:checked, QMenu[qssClass="DWMMenu"] QMenu::indicator:checked {
    image: url(:/qfluentwidgets/images/icons/Accept_white.svg);
}
QMenu[qssClass="DWMMenu"]::icon, QMenu[qssClass="DWMMenu"]::indicator,
QMenu[qssClass="DWMMenu"] QMenu::icon, QMenu[qssClass="DWMMenu"] QMenu::indicator {
    position: relative;
    left: 12px;
}
QMenu[qssClass="DWMMenu"]::right-arrow, QMenu[qssClass="DWMMenu"] QMenu::right-arrow {
    width: 9px;
    height: 9px;
    image: url(:/qfluentwidgets/images/icons/ChevronRight_white.svg);
}


MenuActionListWidget {
    outline: none;
    font: 14px --FontFamilies;
}

#menuPanel {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9px;
    background-color: rgb(43, 43, 43);
}
#menuPanel[acrylic=true] { background-color: transparent; }

MenuActionListWidget::viewport {
    background-color: rgb(43, 43, 43);
    border-radius: 8px;
}

MenuActionListWidget[transparent=true] {
    background-color: transparent;
    border: none;
}

MenuActionListWidget[transparent=true]::viewport {
    background-color: transparent;
}

MenuActionListWidget::item {
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 5px;
    margin-left: 6px;
    margin-right: 6px;
    border: none;
    color: white;
}

MenuActionListWidget::item:disabled {
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 5px;
    border: none;
    color: rgba(255, 255, 255, 0.4);
}

MenuActionListWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

MenuActionListWidget::item:selected {
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
}

MenuActionListWidget::item:selected:active {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.7);
}

#completerListWidget[dropDown=true],
#commandListWidget[dropDown=true][long=false] {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

#commandListWidget[dropDown=true][long=true] {
    border-top-left-radius: 9px;
    border-top-right-radius: 0px;
}

#commandListWidget[dropDown=false][long=true] {
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 0px;
}

#completerListWidget[dropDown=false],
#commandListWidget[dropDown=false][long=false] {
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

#completerListWidget::item,
#comboListWidget::item {
    margin-top: 4px;
}

#checkableListWidget::item {
    padding-left: 36px;
}
